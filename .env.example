# Copy to .env and fill in strong, unique values before `docker compose up`.
# Never commit the real .env file.

PKICA_ENVIRONMENT=production

# --- Audit hash-chain HMAC secret (32+ random bytes, base64) ---
# openssl rand -base64 32
AUDIT_HASH_CHAIN_SECRET=

# --- CA key custody backend: software | aws_kms | azure_key_vault | gcp_kms | vault_transit | pkcs11_hsm ---
CA_KEY_BACKEND=software
# Only relevant for CA_KEY_BACKEND=software, and ONLY for local dev/test:
ALLOW_SOFTWARE_KMS=true
# 32 random bytes, base64: openssl rand -base64 32
SOFTWARE_KMS_MASTER_KEY=

# --- AWS KMS ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Azure Key Vault ---
AZURE_KEY_VAULT_URL=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- GCP KMS ---
GCP_PROJECT_ID=
GCP_LOCATION=
GCP_KMS_KEY_RING=
GOOGLE_APPLICATION_CREDENTIALS=

# --- HashiCorp Vault Transit ---
VAULT_ADDR=
VAULT_TOKEN=

# --- OIDC / SSO (Keycloak, Azure AD, Okta, ...) for human RA approvers ---
OIDC_ISSUER=
OIDC_AUDIENCE=pkica-ra
OIDC_JWKS_URL=

# --- EST enrollment credentials (username:password pairs, comma separated) ---
# Development/testing only — wire up your directory service in production.
EST_ENROLLMENT_USERS=device1:changeme
